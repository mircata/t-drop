# Copy to .env.local and fill in. .env.local is git-ignored.

# Postgres connection string. Local dev: postgres://localhost:5432/tdrop
# Production (Vercel): the Supabase TRANSACTION pooler string, port 6543. Serverless needs it.
DATABASE_URI=
# Migrations need session mode: the Supabase SESSION pooler string, port 5432. Used by `payload migrate` only.
# Leave empty locally when DATABASE_URI already is a session connection.
DATABASE_URI_SESSION=
# Connections per serverless instance (default 3).
DATABASE_POOL_MAX=

# Random string that signs admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public origin of the site, used for absolute links in emails and Stripe redirects.
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Stripe sandbox (task oaz.6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend, for verification and password emails. Empty = emails print to the dev console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@t-drop.net
EMAIL_FROM_NAME=T-Drop

# Uploads in production: Supabase Storage through its S3-compatible endpoint (task oaz.9).
# Leave empty locally; files then go to public/media.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Host that serves the bucket files, for next/image, e.g. <project-ref>.storage.supabase.co
NEXT_PUBLIC_MEDIA_HOST=
